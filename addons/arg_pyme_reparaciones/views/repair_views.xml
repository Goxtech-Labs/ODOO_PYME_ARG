<odoo>
    <record id="repair_list" model="ir.ui.view"><field name="name">arg.pyme.repair.case.list</field><field name="model">arg.pyme.repair.case</field>
        <field name="arch" type="xml"><list js_class="arg_list" limit="50"><field name="arg_number"/><field name="date"/>
            <field name="partner_id"/><field name="equipment"/><field name="symptom" optional="show"/>
            <field name="serial" optional="hide"/><field name="state" widget="badge"/></list></field></record>
    <record id="repair_form" model="ir.ui.view"><field name="name">arg.pyme.repair.case.form</field><field name="model">arg.pyme.repair.case</field>
        <field name="arch" type="xml"><form js_class="arg_form"><header>
            <button name="action_receive" type="object" string="Recibir equipo" class="btn-primary" invisible="state != 'draft'"/>
            <button name="action_record_diagnosis" type="object" string="Registrar diagnóstico" invisible="state != 'received'"/>
            <button name="action_return_unrepaired" type="object" string="Devolver sin reparar" invisible="state not in ['received','diagnosed']"/>
            <button name="action_cancel_draft" type="object" string="Cancelar borrador" invisible="state != 'draft'"/>
            <button name="action_arg_print" type="object" string="Imprimir parte"/><field name="state" widget="statusbar"/>
        </header><sheet><widget name="arg_document_header"/>
            <group><group><field name="date" readonly="state != 'draft'"/><field name="partner_id" readonly="state != 'draft'"/></group>
                <group><field name="arg_number"/><field name="company_id" groups="base.group_multi_company" readonly="id"/>
                    <field name="arg_reference" readonly="state in ['returned','canceled']"/></group></group>
            <group><field name="equipment" readonly="state != 'draft'"/><field name="symptom" readonly="state != 'draft'"/></group>
            <notebook>
                <page string="Datos del equipo"><group><group><field name="brand" readonly="state != 'draft'"/>
                    <field name="model" readonly="state != 'draft'"/><field name="serial" readonly="state != 'draft'"/></group>
                    <group><field name="accessories" readonly="state != 'draft'"/><field name="condition_note" readonly="state != 'draft'"/></group></group></page>
                <page string="Diagnóstico" invisible="state in ['draft','canceled']"><field name="diagnosis" readonly="state != 'received'"/></page>
                <page string="Observaciones"><field name="notes" readonly="state in ['returned','canceled']"/></page>
                <page string="Historial"><field name="event_ids"><list create="0" edit="0" delete="0">
                    <field name="effective_date"/><field name="kind"/><field name="actor_id"/><field name="recorded_at"/>
                </list><form><group><field name="effective_date"/><field name="kind"/><field name="actor_id"/><field name="recorded_at"/><field name="evidence"/></group></form></field></page>
            </notebook>
        </sheet></form></field></record>
    <record id="repair_search" model="ir.ui.view"><field name="name">arg.pyme.repair.case.search</field><field name="model">arg.pyme.repair.case</field>
        <field name="arch" type="xml"><search><field name="arg_number"/><field name="partner_id"/><field name="equipment"/><field name="serial"/>
            <filter name="in_custody" string="En custodia" domain="[('state','in',['received','diagnosed'])]"/>
            <filter name="draft" string="Borradores" domain="[('state','=','draft')]"/>
            <filter name="by_partner" string="Cliente" context="{'group_by':'partner_id'}"/>
        </search></field></record>
    <record id="action_repairs" model="ir.actions.act_window"><field name="name">Partes de reparación ARG</field>
        <field name="res_model">arg.pyme.repair.case</field><field name="view_mode">list,form</field>
        <field name="view_id" ref="repair_list"/><field name="search_view_id" ref="repair_search"/></record>
    <record id="action_repairs_list" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="repair_list"/><field name="act_window_id" ref="action_repairs"/></record>
    <record id="action_repairs_form" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="repair_form"/><field name="act_window_id" ref="action_repairs"/></record>
    <menuitem id="menu_repairs" name="Reparaciones" parent="arg_pyme_base.menu_arg_ventas" action="action_repairs" sequence="65" groups="arg_pyme_reparaciones.group_repair"/>
</odoo>
