<odoo>
    <record id="value_list" model="ir.ui.view">
        <field name="name">arg.pyme.value.instrument.list</field>
        <field name="model">arg.pyme.value.instrument</field>
        <field name="arch" type="xml"><list js_class="arg_list" limit="50">
            <field name="arg_number"/><field name="date"/><field name="partner_id"/>
            <field name="instrument_kind"/><field name="ownership"/>
            <field name="amount"/><field name="currency_id"/>
            <field name="payable_on"/><field name="instrument_number" optional="show"/>
            <field name="bank_name" optional="hide"/><field name="state" widget="badge"/>
        </list></field>
    </record>
    <record id="value_form" model="ir.ui.view">
        <field name="name">arg.pyme.value.instrument.form</field>
        <field name="model">arg.pyme.value.instrument</field>
        <field name="arch" type="xml"><form js_class="arg_form">
            <header>
                <button name="action_value_operation" type="object" string="Operación de cheque" invisible="state not in ['portfolio','deposited','transferred','transferred_closed','own_issued','disputed'] or (state == 'disputed' and ownership == 'own') or (state == 'transferred_closed' and exposure_amount == 0)" groups="arg_pyme_administracion.group_finance_manager"/>
                <button name="action_cancel_draft" type="object" string="Cancelar borrador" invisible="state != 'draft'"/>
                <button name="action_arg_print" type="object" string="Imprimir registro"/>
                <field name="state" widget="statusbar"/>
            </header>
            <sheet>
                <widget name="arg_document_header"/>
                <group><group>
                    <field name="date" readonly="state != 'draft'"/>
                    <field name="partner_id" readonly="state != 'draft'"/>
                    <field name="instrument_kind" readonly="id"/>
                    <field name="amount" readonly="state != 'draft'"/>
                </group><group>
                    <field name="ownership" readonly="state != 'draft'"/>
                    <field name="currency_id" readonly="state != 'draft'"/>
                    <field name="company_id" groups="base.group_multi_company" readonly="id"/>
                </group></group>
                <p class="text-muted">Completá los datos del título antes de seleccionarlo en un recibo. El depósito y la acreditación se registran por separado.</p>
                <notebook>
                    <page string="Datos del título"><group><group>
                        <field name="support" readonly="state != 'draft'"/>
                        <field name="cheque_type" invisible="instrument_kind != 'cheque'" readonly="state != 'draft'"/>
                        <field name="instrument_number" readonly="state != 'draft'"/>
                        <field name="electronic_identifier" invisible="support != 'electronic'" readonly="state != 'draft'"/>
                        <field name="issued_on" readonly="state != 'draft'"/>
                        <field name="payable_on" readonly="state != 'draft'"/>
                    </group><group>
                        <field name="bank_account_id" readonly="state != 'draft'"/>
                        <field name="bank_name" readonly="state != 'draft'"/>
                        <field name="bank_identifier" readonly="state != 'draft'"/>
                        <field name="issuer_account" readonly="state != 'draft'"/>
                        <field name="issuer_id" readonly="state != 'draft'"/>
                        <field name="issuer_identifier" readonly="state != 'draft'"/>
                        <field name="beneficiary_id" readonly="state != 'draft'"/>
                    </group></group></page>
                    <page string="Cartera y origen"><group><field name="receipt_line_id"/><field name="reservation_line_id"/><field name="outgoing_line_id"/><field name="available_amount"/><field name="exposure_amount"/><field name="exposure_unknown"/><field name="portfolio_amount"/><field name="credited_amount"/><field name="deposit_journal_id"/><field name="deposited_on"/><field name="settlement_move_id"/><field name="rejection_move_id"/></group></page>
                    <page string="Entregas y responsabilidad"><field name="linked_treasury_line_ids"><list create="0" delete="0" edit="0"><field name="document_id"/><field name="amount"/><field name="currency_id"/><field name="value_transmission"/><field name="value_recourse_condition"/><field name="value_exposure_open"/><field name="value_exposure_closed_on"/><field name="value_reversal_move_id"/><field name="value_bank_move_id"/></list></field></page>
                    <page string="Observaciones"><field name="note" readonly="state != 'draft'"/></page>
                    <page string="Historial"><field name="event_ids"><list create="0" delete="0" edit="0">
                        <field name="recorded_at"/><field name="actor_id"/><field name="kind"/>
                        <field name="request_key" optional="hide"/>
                    </list></field></page>
                </notebook>
            </sheet>
        </form></field>
    </record>
    <record id="value_search" model="ir.ui.view">
        <field name="name">arg.pyme.value.instrument.search</field>
        <field name="model">arg.pyme.value.instrument</field>
        <field name="arch" type="xml"><search>
            <field name="arg_number"/><field name="partner_id"/><field name="instrument_number"/>
            <field name="electronic_identifier"/><field name="issuer_id"/><field name="bank_name"/>
            <filter name="draft" string="Borradores" domain="[('state','=','draft')]"/>
            <filter name="third_party" string="De terceros" domain="[('ownership','=','third_party')]"/>
            <filter name="own" string="Propios" domain="[('ownership','=','own')]"/>
            <filter name="by_partner" string="Tercero" context="{'group_by':'partner_id'}"/>
        </search></field>
    </record>
    <record id="action_values" model="ir.actions.act_window">
        <field name="name">Registro de valores ARG</field>
        <field name="res_model">arg.pyme.value.instrument</field>
        <field name="view_mode">list,form</field><field name="view_id" ref="value_list"/>
        <field name="search_view_id" ref="value_search"/>
    </record>
    <record id="action_values_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field><field name="view_mode">list</field>
        <field name="view_id" ref="value_list"/><field name="act_window_id" ref="action_values"/>
    </record>
    <record id="action_values_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field><field name="view_mode">form</field>
        <field name="view_id" ref="value_form"/><field name="act_window_id" ref="action_values"/>
    </record>
    <menuitem id="menu_values" name="Registro de valores" parent="arg_pyme_base.menu_arg_administracion"
              action="action_values" sequence="55" groups="arg_pyme_base.group_administracion"/>
</odoo>
