<odoo>
<record id="action_stock_trace" model="ir.actions.client"><field name="name">Series y lotes ARG</field><field name="tag">arg_pyme.stock_trace</field></record>
<menuitem id="menu_stock_trace" name="Series y lotes" parent="arg_pyme_base.menu_arg_stock" action="action_stock_trace" sequence="30"/>
<record id="lot_create_form" model="ir.ui.view"><field name="name">arg.pyme.lot.create.form</field><field name="model">arg.pyme.lot.create</field><field name="arch" type="xml"><form string="Nueva serie o lote ARG"><group><field name="product_id" options="{'no_create': True}"/><field name="name" placeholder="Número del fabricante, con sus ceros iniciales"/><field name="ref"/><field name="company_id" readonly="1"/></group><p class="text-muted">Las existencias se registran en una recepción o un inventario validado.</p><footer><button name="action_create_lot" type="object" string="Crear y consultar" class="btn-primary"/><button string="Cancelar" special="cancel" class="btn-secondary"/></footer></form></field></record>
<record id="lot_form_trace_arg" model="ir.ui.view"><field name="name">stock.lot.trace.arg</field><field name="model">stock.lot</field><field name="inherit_id" ref="stock.view_production_lot_form"/><field name="arch" type="xml"><xpath expr="//div[@name='button_box']" position="inside"><button name="action_arg_trace" type="object" class="oe_stat_button" string="Consulta ARG" groups="arg_pyme_base.group_stock" invisible="not id"><img src="/arg_pyme_ui/static/icons/lucide/package.svg" class="arg_icon" alt=""/><span class="o_stat_text">Consulta ARG</span></button></xpath></field></record>
</odoo>