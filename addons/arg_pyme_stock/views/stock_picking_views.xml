<odoo>
<record id="picking_list" model="ir.ui.view"><field name="name">stock.picking.arg.list</field><field name="model">stock.picking</field><field name="arch" type="xml"><list js_class="arg_list"><field name="arg_number"/><field name="scheduled_date"/><field name="partner_id"/><field name="picking_type_id"/><field name="location_id" optional="show"/><field name="location_dest_id" optional="show"/><field name="state" widget="badge"/><field name="origin" optional="show"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
<record id="picking_form" model="ir.ui.view"><field name="name">stock.picking.arg.form</field><field name="model">stock.picking</field><field name="arch" type="xml"><form js_class="arg_form"><header><button name="action_confirm" type="object" string="Preparar" invisible="state != 'draft'"/><button name="action_assign" type="object" string="Reservar disponible" invisible="state in ['draft','done','cancel']"/><button name="button_validate" type="object" string="Validar cantidades" class="btn-primary" invisible="state in ['done','cancel']" groups="arg_pyme_base.group_manager"/><button name="action_return" type="object" string="Preparar devolución" invisible="state != 'done'"/><button name="action_return_all" type="object" string="Proponer pendiente de devolución" invisible="not return_id or state in ['done','cancel']"/><button name="action_cancel" type="object" string="Cancelar" invisible="state in ['done','cancel']" groups="arg_pyme_base.group_manager"/><button name="action_arg_print" type="object" string="Imprimir"/><field name="state" widget="statusbar"/></header><sheet><widget name="arg_document_header"/><group><group><field name="scheduled_date" readonly="state in ['done','cancel']"/><field name="partner_id" readonly="state in ['done','cancel']"/><field name="picking_type_id" readonly="arg_number"/></group><group><field name="company_id" groups="base.group_multi_company" readonly="arg_number"/><field name="location_id" readonly="state != 'draft'"/><field name="location_dest_id" readonly="state != 'draft'"/><field name="origin"/></group></group><field name="move_ids" readonly="state in ['done','cancel']"><list editable="bottom"><field name="product_id"/><field name="product_uom_qty" string="Previsto"/><field name="uom_id"/><field name="quantity" string="Cantidad operada"/><field name="picked" optional="show"/><field name="state" optional="hide"/><button name="action_show_details" type="object" string="Lotes / detalle"/></list></field><p class="text-muted">Revisá cantidades operadas antes de validar. Las cantidades no realizadas quedan pendientes o se cierran expresamente mediante el asistente nativo. Usá Lotes / detalle sólo cuando corresponda.</p><group><field name="backorder_id" readonly="1"/><field name="return_id" readonly="1"/><field name="date_done" readonly="1"/></group></sheet></form></field></record>
<record id="action_pickings" model="ir.actions.act_window"><field name="name">Movimientos ARG</field><field name="res_model">stock.picking</field><field name="view_mode">list,form</field><field name="view_id" ref="picking_list"/></record><record id="action_pickings_list" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="picking_list"/><field name="act_window_id" ref="action_pickings"/></record><record id="action_pickings_form" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="picking_form"/><field name="act_window_id" ref="action_pickings"/></record><menuitem id="menu_pickings" name="Movimientos" parent="arg_pyme_base.menu_arg_stock" action="action_pickings" sequence="20"/>
<record id="product_stock_options" model="ir.ui.view"><field name="name">product.template.arg.stock.options</field><field name="model">product.template</field><field name="inherit_id" ref="arg_pyme_catalogo.product_form"/><field name="arch" type="xml"><xpath expr="//field[@name='purchase_ok']" position="after"><field name="is_storable" invisible="type != 'consu'"/><field name="tracking" invisible="not is_storable"/></xpath></field></record>
</odoo>
