<record id="action_counts" model="ir.actions.act_window"><field name="name">Inventarios ARG</field><field name="res_model">arg.pyme.inventory.count</field><field name="view_mode">list,form</field><field name="view_id" ref="inventory_count_list"/></record><record id="action_counts_list" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="inventory_count_list"/><field name="act_window_id" ref="action_counts"/></record><record id="action_counts_form" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="inventory_count_form"/><field name="act_window_id" ref="action_counts"/></record><menuitem id="menu_counts" name="Inventarios" parent="arg_pyme_base.menu_arg_stock" action="action_counts" sequence="30"/></odoo>