<templates xml:space="preserve"><t t-name="arg_pyme_stock.Matrix"><section class="arg_stock_matrix p-3 overflow-auto h-100"><h2>Existencias ARG</h2><p><t t-esc="this.state.company"/> · Consulta actual: <t t-esc="this.state.asOf"/> UTC</p><div class="d-flex gap-2 flex-wrap align-items-end mb-3"><label>Depósito<select class="form-select" t-on-change="ev => {this.state.warehouse=Number(ev.target.value);this.state.location=0;}"><t t-foreach="this.state.warehouses" t-as="row" t-key="row.id"><option t-att-value="row.id" t-att-selected="row.id===this.state.warehouse"><t t-esc="row.name"/></option></t></select></label><label>Ubicación<select class="form-select" t-on-change="ev => this.state.location=Number(ev.target.value)"><option value="0">Todo el depósito</option><t t-foreach="this.state.locations" t-as="row" t-key="row.id"><option t-att-value="row.id"><t t-esc="row.name"/></option></t></select></label><label>Producto<input class="form-control" t-att-value="this.state.query" t-on-input="ev => this.state.query=ev.target.value"/></label><button class="btn btn-primary" t-on-click="() => this.load(0)" t-att-disabled="this.state.loading">Consultar</button></div><p class="text-muted">Disponible es cantidad utilizable. Las reservas y otras restricciones, como vencimientos, pueden reducirla. Previsto incluye entradas y salidas pendientes.</p><div t-if="this.state.error" class="alert alert-danger"><t t-esc="this.state.error"/></div><table class="table table-sm table-striped"><thead><tr><th>Código</th><th>Producto</th><th>Unidad</th><th>Físico</th><th>Reservado</th><th>Disponible</th><th>Entrante</th><th>Saliente</th><th>Previsto</th><th>Otras restricciones</th></tr></thead><tbody><tr t-foreach="this.state.rows" t-as="row" t-key="row.id"><td t-esc="row.code"/><td t-esc="row.name"/><td t-esc="row.unit"/><td t-esc="this.format(row.physical)"/><td t-esc="this.format(row.reserved)"/><td t-esc="this.format(row.available)"/><td t-esc="this.format(row.incoming)"/><td t-esc="this.format(row.outgoing)"/><td t-esc="this.format(row.forecast)"/><td t-esc="this.format(row.other_unavailable)"/></tr></tbody></table><div class="d-flex gap-2 align-items-center"><button class="btn btn-secondary" t-on-click="() => this.load(Math.max(0,this.state.offset-30))" t-att-disabled="this.state.offset===0||this.state.loading">Anterior</button><span><t t-esc="this.state.offset+1"/>–<t t-esc="this.state.offset+this.state.rows.length"/> de <t t-esc="this.state.count"/></span><button class="btn btn-secondary" t-on-click="() => this.load(this.state.offset+30)" t-att-disabled="this.state.offset+30>=this.state.count||this.state.loading">Siguiente</button></div></section></t></templates>