<templates xml:space="preserve">
<t t-name="arg_pyme_stock.TraceChoiceDialog"><Dialog title="this.title" size="'md'">
 <form class="d-flex flex-wrap gap-2 mb-2" t-on-submit.prevent="() => this.load(0)"><label class="flex-grow-1">Buscar<input class="form-control" t-att-value="this.state.query" t-on-input="ev => this.state.query=ev.target.value"/></label><button class="btn btn-secondary" type="submit" t-att-disabled="this.state.loading">Buscar</button></form>
 <p role="status" t-if="this.state.loading">Buscando…</p><p role="alert" t-if="this.state.error" t-esc="this.state.error"/>
 <div class="d-flex flex-column gap-2"><button class="btn btn-secondary text-start" t-foreach="this.state.rows" t-as="row" t-key="row.id" t-att-disabled="this.state.loading" t-on-click="() => this.choose(row)"><strong t-esc="row.name"/><t t-if="row.ref"> · <t t-esc="row.ref"/></t><small class="d-block" t-if="row.product"><t t-esc="row.product.code"/> · <t t-esc="row.product.name"/></small><small class="d-block" t-else=""><t t-esc="row.code"/> · <t t-esc="row.unit.name"/></small></button></div>
 <p t-if="!this.state.rows.length &amp;&amp; !this.state.loading">Sin resultados visibles.</p>
 <t t-set-slot="footer"><button class="btn btn-secondary" t-att-disabled="!this.state.offset || this.state.loading" t-on-click="() => this.load(Math.max(0,this.state.offset-30))">Anterior</button><span><t t-esc="this.state.count"/> resultados</span><button class="btn btn-secondary" t-att-disabled="this.state.offset+30 &gt;= this.state.count || this.state.loading" t-on-click="() => this.load(this.state.offset+30)">Siguiente</button><button class="btn btn-secondary" t-on-click="this.props.close">Cerrar</button></t>
</Dialog></t>
<t t-name="arg_pyme_stock.StockTrace"><div class="arg_stock_trace h-100 overflow-auto p-3">
 <div class="d-flex flex-wrap align-items-center gap-2 mb-3"><h2 class="me-auto mb-0"><img class="arg_icon me-2" src="/arg_pyme_ui/static/icons/lucide/package.svg" alt=""/>Series y lotes ARG</h2><button class="btn btn-secondary" t-if="this.state.canCreate" t-att-disabled="this.busy" t-on-click="this.createLot">Nueva serie o lote</button></div>
 <p class="text-muted"><t t-esc="this.state.company"/> · Historia de movimientos finalizados y existencias actuales visibles.</p>
 <div class="d-flex flex-wrap align-items-end gap-3 mb-3"><div><span class="d-block">Producto (opcional)</span><button class="btn btn-secondary" t-att-disabled="this.busy" t-on-click="() => this.pick('product')"><t t-esc="this.state.product?.name || 'Todos los productos rastreables'"/></button><button class="btn btn-secondary ms-1" t-if="this.state.product" t-att-disabled="this.busy" t-on-click="this.clearProduct">Quitar filtro</button></div><div><span class="d-block">Serie o lote</span><button class="btn btn-secondary" t-att-disabled="this.busy" t-on-click="() => this.pick('lot')"><t t-esc="this.state.lot?.name || 'Elegir serie o lote'"/></button></div><button class="btn btn-primary" t-att-disabled="this.busy || !this.state.lot" t-on-click="() => this.load(0)">Consultar</button></div>
 <details class="mb-3"><summary>Período de la historia (opcional)</summary><div class="d-flex flex-wrap gap-3 mt-2"><div><label class="d-block" for="arg-trace-start">Desde fecha y hora</label><DateTimeInput id="'arg-trace-start'" type="'datetime'" value="this.startValue" onChange="value => this.range('start',value)" disabled="this.busy"/></div><div><label class="d-block" for="arg-trace-end">Hasta fecha y hora</label><DateTimeInput id="'arg-trace-end'" type="'datetime'" value="this.endValue" onChange="value => this.range('end',value)" disabled="this.busy"/></div></div><p class="text-muted mt-2">Aplicá con Consultar. El rango limita movimientos; las cantidades actuales se identifican aparte.</p></details>
 <details class="mb-3" t-if="this.state.lot"><summary>Herramientas avanzadas</summary><div class="d-flex flex-wrap gap-2 mt-2"><button class="btn btn-secondary" t-att-disabled="this.busy" t-on-click="this.lotCard">Ficha nativa</button><button class="btn btn-secondary" t-att-disabled="this.busy" t-on-click="this.advanced">Traza nativa</button></div></details>
 <div class="alert alert-danger" role="alert" t-if="this.state.error" t-esc="this.state.error"/><p role="status" t-if="this.state.loading">Consultando historia…</p>
 <div class="alert alert-info" role="status" t-if="this.dirty">Hay fechas sin aplicar. La tabla conserva el rango indicado en su cabecera.</div>
 <section t-if="this.state.result" aria-label="Historia de la serie o lote"><h3><t t-esc="this.state.result.lot.name"/> · <t t-esc="this.state.result.lot.product.name"/></h3><p>Consulta: <t t-esc="this.when(this.state.result.as_of)"/> · Desde: <t t-esc="this.when(this.state.result.start)"/> · Hasta: <t t-esc="this.when(this.state.result.end)"/></p>
  <p class="alert alert-info" role="status" t-if="this.state.result.history.status!=='known'" t-esc="this.state.result.history.reason"/>
  <div class="table-responsive" t-else=""><table class="table table-sm table-bordered align-middle"><thead><tr><th>Fecha</th><th>Hecho / documento</th><th>Origen</th><th>Destino</th><th class="text-end">Cantidad finalizada</th><th>Unidad</th></tr></thead><tbody><tr t-foreach="this.state.result.history.rows" t-as="row" t-key="row.id"><td t-esc="this.when(row.when)"/><td><strong t-esc="this.kind(row)"/><br/><button class="btn btn-secondary btn-sm" t-if="row.document.status==='known'" t-att-disabled="this.busy" t-on-click="() => this.document(row)"><t t-esc="row.document.name"/></button><span t-else="" t-esc="row.document.name"/><small class="d-block" t-if="row.return_of.status==='known'">Devolución de <t t-esc="row.return_of.name"/></small></td><td t-esc="row.source.name"/><td t-esc="row.destination.name"/><td class="text-end" t-esc="this.number(row.quantity)"/><td t-esc="row.unit.name"/></tr></tbody></table><p t-if="!this.state.result.history.rows.length">Sin movimientos finalizados visibles en este rango.</p><div class="d-flex flex-wrap align-items-center gap-2"><button class="btn btn-secondary" t-att-disabled="!this.state.result.history.offset || this.busy" t-on-click="() => this.page(Math.max(0,this.state.result.history.offset-30))">Anterior</button><span><t t-esc="this.state.result.history.count"/> movimientos visibles</span><button class="btn btn-secondary" t-att-disabled="this.state.result.history.offset+30 &gt;= this.state.result.history.count || this.busy" t-on-click="() => this.page(this.state.result.history.offset+30)">Siguiente</button></div></div>
 </section>
 <p role="status" t-if="this.state.qLoading">Consultando cantidades actuales…</p><p role="alert" t-if="this.state.qError" t-esc="this.state.qError"/>
 <section class="mt-3" t-if="this.state.quantities" aria-label="Existencias actuales"><h3>Existencia actual visible</h3><p class="text-end fs-4"><strong t-esc="this.number(this.state.quantities.total)"/> <t t-esc="this.state.quantities.unit.name"/></p><p>Consulta: <t t-esc="this.when(this.state.quantities.as_of)"/> · <t t-esc="this.state.quantities.scope"/></p>
  <p class="alert alert-info" role="status" t-if="this.state.quantities.status!=='known'" t-esc="this.state.quantities.reason"/>
  <details t-else=""><summary>Detalle por ubicación, propietario y paquete</summary><div class="table-responsive mt-2"><table class="table table-sm table-bordered align-middle"><thead><tr><th>Ubicación</th><th>Propietario</th><th>Paquete</th><th class="text-end">Cantidad</th><th class="text-end">Reservada</th></tr></thead><tbody><tr t-foreach="this.state.quantities.rows" t-as="row" t-key="row.id"><td t-esc="row.location.name"/><td t-esc="row.owner.name"/><td t-esc="row.package.name"/><td class="text-end" t-esc="this.number(row.quantity)"/><td class="text-end" t-esc="this.number(row.reserved)"/></tr></tbody></table><p t-if="!this.state.quantities.rows.length">Sin existencias visibles en estas ubicaciones.</p></div><div class="d-flex flex-wrap gap-2 align-items-center"><button class="btn btn-secondary" t-att-disabled="!this.state.quantities.offset || this.busy" t-on-click="() => this.quantPage(Math.max(0,this.state.quantities.offset-30))">Anterior</button><span><t t-esc="this.state.quantities.count"/> registros visibles</span><button class="btn btn-secondary" t-att-disabled="this.state.quantities.offset+30 &gt;= this.state.quantities.count || this.busy" t-on-click="() => this.quantPage(this.state.quantities.offset+30)">Siguiente</button></div></details>
 </section>
</div></t>
</templates>