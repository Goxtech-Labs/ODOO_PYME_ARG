<odoo>
    <record id="arg_pyme_base.group_administracion" model="res.groups">
        <field name="implied_ids" eval="[(4,ref('account.group_account_readonly'))]"/>
    </record>
    <record id="arg_pyme_base.group_admin" model="res.groups">
        <field name="implied_ids" eval="[(4,ref('arg_pyme_base.group_administracion'))]"/>
    </record>
    <record id="group_finance_manager" model="res.groups">
        <field name="name">Responsable Administración ARG</field>
        <field name="privilege_id" ref="arg_pyme_base.privilege_administracion"/>
        <field name="implied_ids" eval="[(4,ref('arg_pyme_base.group_administracion')),(4,ref('arg_pyme_base.group_manager')),(4,ref('account.group_account_invoice'))]"/>
    </record>
    <record id="arg_pyme_base.group_admin" model="res.groups">
        <field name="implied_ids" eval="[(4,ref('group_finance_manager'))]"/>
    </record>
</odoo>
