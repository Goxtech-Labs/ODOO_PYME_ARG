<odoo>
    <record id="cash_lines_list" model="ir.ui.view"><field name="name">account.move.line.cash.arg</field><field name="model">account.move.line</field>
        <field name="arch" type="xml"><list string="Movimientos de caja y banco ARG" create="false" edit="false" delete="false" limit="50" default_order="date desc,id desc" js_class="arg_list">
            <field name="date"/><field name="partner_id"/><field name="move_id"/><field name="journal_id"/><field name="account_id"/>
            <field name="currency_id"/><field name="arg_cash_amount"/><field name="company_currency_id" optional="hide"/><field name="arg_cash_company_amount" optional="hide"/>
            <field name="company_id" groups="base.group_multi_company"/><field name="name" optional="hide"/>
            <button name="action_arg_account_document" type="object" string="Documento de origen" icon="fa-external-link"/>
        </list></field>
    </record>
    <record id="cash_lines_form" model="ir.ui.view"><field name="name">account.move.line.cash.form.arg</field><field name="model">account.move.line</field>
        <field name="arch" type="xml"><form string="Movimiento de caja / banco ARG" create="false" edit="false" delete="false">
            <header><button name="action_arg_account_document" type="object" string="Documento de origen" class="oe_highlight"/></header><sheet>
                <group><field name="partner_id"/><field name="move_id"/><field name="date"/><field name="journal_id"/><field name="account_id"/><field name="name"/></group>
                <group><field name="currency_id"/><field name="arg_cash_amount"/><field name="company_currency_id"/><field name="arg_cash_company_amount"/><field name="company_id"/></group>
            </sheet></form></field>
    </record>
    <record id="cash_lines_search" model="ir.ui.view"><field name="name">account.move.line.cash.search.arg</field><field name="model">account.move.line</field>
        <field name="arch" type="xml"><search><field name="partner_id"/><field name="move_id"/><field name="journal_id"/><field name="account_id"/><field name="date"/>
            <filter name="date" string="Fecha" date="date"/><separator/>
            <filter name="company" string="Compañía" context="{'group_by':'company_id'}"/>
            <filter name="currency" string="Moneda" context="{'group_by':'currency_id'}"/>
            <filter name="journal" string="Diario" context="{'group_by':'journal_id'}"/>
            <filter name="account" string="Cuenta" context="{'group_by':'account_id'}"/>
            <filter name="by_date" string="Fecha" context="{'group_by':'date:month'}"/>
        </search></field>
    </record>
    <record id="action_cash_lines" model="ir.actions.act_window"><field name="name">Caja y banco ARG</field><field name="res_model">account.move.line</field>
        <field name="view_mode">list,form</field><field name="view_id" ref="cash_lines_list"/><field name="search_view_id" ref="cash_lines_search"/>
        <field name="domain">[('parent_state','=','posted'),('account_type','=','asset_cash')]</field>
        <field name="context">{'search_default_company':1,'search_default_currency':2,'search_default_journal':3}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Sin apuntes publicados de caja o banco.</p><p>Se consultan cuentas de liquidez. Los cobros/pagos en cuentas transitorias se ven en Registros de cobro y pago.</p></field>
    </record>
    <record id="cash_lines_action_list" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_cash_lines"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="cash_lines_list"/></record>
    <record id="cash_lines_action_form" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_cash_lines"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="cash_lines_form"/></record>
    <record id="registered_payments_list" model="ir.ui.view"><field name="name">account.payment.registered.arg</field><field name="model">account.payment</field>
        <field name="arch" type="xml"><list string="Registros de cobro y pago ARG" create="false" edit="false" delete="false" limit="50" default_order="date desc,id desc" js_class="arg_list">
            <field name="partner_id"/><field name="name"/><field name="arg_treasury_document_id"/><field name="date"/>
            <field name="journal_id"/><field name="currency_id"/><field name="arg_registered_amount"/><field name="arg_payment_effect" widget="badge"/>
            <field name="state"/><field name="move_id"/><field name="outstanding_account_id" optional="show"/>
            <field name="company_id" groups="base.group_multi_company"/>
        </list></field>
    </record>
    <record id="action_registered_payments" model="ir.actions.act_window"><field name="name">Registros de cobro y pago ARG</field><field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field><field name="view_id" ref="registered_payments_list"/>
        <field name="domain">[('move_id.state','=','posted'),('state','in',['paid','reconciled'])]</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Sin cobros/pagos registrados.</p><p>Registrar una transferencia manual no la ejecuta en el banco. Se distingue cuenta transitoria, estado y asiento inverso.</p></field>
    </record>
    <menuitem id="menu_cash_lines" name="Caja y banco" parent="arg_pyme_base.menu_arg_administracion" action="action_cash_lines" sequence="50" groups="arg_pyme_base.group_administracion"/>
    <menuitem id="menu_registered_payments" name="Registros de cobro y pago" parent="arg_pyme_base.menu_arg_administracion" action="action_registered_payments" sequence="60" groups="arg_pyme_base.group_administracion"/>
</odoo>
