<odoo>
    <record id="current_account_list" model="ir.ui.view">
        <field name="name">account.move.line.current.account.arg</field><field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <list string="Cuenta corriente ARG" create="false" edit="false" delete="false" limit="50" default_order="date_maturity,id" js_class="arg_list">
                <field name="partner_id"/><field name="arg_account_document"/><field name="arg_account_origin_type" optional="show"/>
                <field name="date"/><field name="date_maturity" string="Vencimiento"/>
                <field name="currency_id"/><field name="arg_account_original"/><field name="arg_account_residual"/>
                <field name="arg_account_progress" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="account_id" optional="hide"/><field name="name" optional="hide"/>
                <field name="company_currency_id" column_invisible="True"/>
                <field name="arg_account_company_residual" optional="hide"/>
                <button name="action_arg_account_document" type="object" string="Documento de origen" icon="fa-external-link"/>
            </list>
        </field>
    </record>
    <record id="current_account_form" model="ir.ui.view">
        <field name="name">account.move.line.current.account.form.arg</field><field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <form string="Vencimiento ARG" create="false" edit="false" delete="false">
                <header><button name="action_arg_account_document" type="object" string="Documento de origen" class="oe_highlight"/></header>
                <sheet>
                    <group><field name="partner_id"/><field name="arg_account_document"/><field name="arg_account_origin_type"/></group>
                    <group><group><field name="date"/><field name="date_maturity"/><field name="company_id"/><field name="currency_id"/></group>
                    <group><field name="arg_account_original"/><field name="arg_account_residual"/><field name="arg_account_progress"/>
                    <field name="company_currency_id"/><field name="arg_account_company_residual"/></group></group>
                    <div class="alert alert-info" role="note">Saldo de este apunte o cuota, en su moneda. Deuda saldada no equivale a cobro o pago de dinero.
                    Notas, anticipos y ajustes se consultan en el documento de origen.</div>
                    <group><field name="move_id"/><field name="account_id"/><field name="name"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="current_account_search" model="ir.ui.view">
        <field name="name">account.move.line.current.account.search.arg</field><field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <search string="Cuentas corrientes ARG">
                <field name="partner_id"/><field name="move_id"/><field name="name"/><field name="currency_id"/><field name="company_id"/>
                <filter name="open" string="Con saldo" domain="['|',('amount_residual','!=',0),('amount_residual_currency','!=',0)]"/>
                <filter name="overdue" string="Vencidos con saldo" domain="[('date_maturity','&lt;',context_today().strftime('%Y-%m-%d')),'|',('amount_residual','!=',0),('amount_residual_currency','!=',0)]"/>
                <filter name="credits" string="Créditos / anticipos" domain="['|','&amp;',('account_type','=','asset_receivable'),('balance','&lt;',0),'&amp;',('account_type','=','liability_payable'),('balance','&gt;',0)]"/>
                <filter name="invoice_origins" string="Facturas y notas" domain="[('move_id.move_type','in',['out_invoice','out_refund','in_invoice','in_refund'])]"/>
                <separator/>
                <filter name="by_company" string="Compañía" context="{'group_by':'company_id'}"/>
                <filter name="by_currency" string="Moneda" context="{'group_by':'currency_id'}"/>
                <filter name="by_partner" string="Tercero" context="{'group_by':'partner_id'}"/>
                <filter name="by_document" string="Documento" context="{'group_by':'move_id'}"/>
                <filter name="by_maturity" string="Vencimiento" context="{'group_by':'date_maturity:month'}"/>
            </search>
        </field>
    </record>
    <record id="action_customer_account" model="ir.actions.act_window">
        <field name="name">Cuentas de clientes ARG</field><field name="res_model">account.move.line</field>
        <field name="view_mode">list,form</field><field name="view_id" ref="current_account_list"/>
        <field name="search_view_id" ref="current_account_search"/>
        <field name="domain">[('parent_state','=','posted'),('account_type','=','asset_receivable')]</field>
        <field name="context">{'search_default_open':1,'search_default_by_company':1,'search_default_by_currency':2}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Sin vencimientos publicados para esta consulta.</p><p>La consulta distingue deuda y crédito, por moneda y compañía. No registra cobros.</p></field>
    </record>
    <record id="action_supplier_account" model="ir.actions.act_window">
        <field name="name">Cuentas de proveedores ARG</field><field name="res_model">account.move.line</field>
        <field name="view_mode">list,form</field><field name="view_id" ref="current_account_list"/>
        <field name="search_view_id" ref="current_account_search"/>
        <field name="domain">[('parent_state','=','posted'),('account_type','=','liability_payable')]</field>
        <field name="context">{'search_default_open':1,'search_default_by_company':1,'search_default_by_currency':2}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Sin vencimientos publicados para esta consulta.</p><p>Los saldos se muestran en su moneda, sin sumar ARS con USD. Esta pantalla no ejecuta transferencias.</p></field>
    </record>
    <record id="customer_account_list_view" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="action_customer_account"/><field name="view_mode">list</field><field name="view_id" ref="current_account_list"/><field name="sequence">10</field>
    </record>
    <record id="supplier_account_list_view" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="action_supplier_account"/><field name="view_mode">list</field><field name="view_id" ref="current_account_list"/><field name="sequence">10</field>
    </record>
    <record id="customer_account_form_view" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="action_customer_account"/><field name="view_mode">form</field><field name="view_id" ref="current_account_form"/><field name="sequence">20</field>
    </record>
    <record id="supplier_account_form_view" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="action_supplier_account"/><field name="view_mode">form</field><field name="view_id" ref="current_account_form"/><field name="sequence">20</field>
    </record>
    <menuitem id="menu_customer_account" name="Cuentas de clientes" parent="arg_pyme_base.menu_arg_administracion" action="action_customer_account" sequence="10" groups="arg_pyme_base.group_administracion"/>
    <menuitem id="menu_supplier_account" name="Cuentas de proveedores" parent="arg_pyme_base.menu_arg_administracion" action="action_supplier_account" sequence="20" groups="arg_pyme_base.group_administracion"/>
</odoo>
