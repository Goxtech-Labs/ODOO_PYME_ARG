<templates xml:space="preserve"><t t-name="arg_pyme_ui.DocumentButtons"><div class="arg_document_actions d-flex flex-wrap gap-1" role="toolbar" aria-label="Acciones del documento"><t t-if="this.canEdit"><button type="button" class="btn btn-success o_form_button_save" t-on-click="() => this.saveButtonClicked()" data-hotkey="s"><img class="arg_icon me-1" src="/arg_pyme_ui/static/icons/lucide/save.svg" alt=""/>Guardar</button><button t-if="this.canCreate" type="button" class="btn btn-outline-success" t-on-click="() => this.argSaveNew()"><img class="arg_icon me-1" src="/arg_pyme_ui/static/icons/lucide/file-plus.svg" alt=""/>Guardar y nuevo</button><button type="button" class="btn btn-outline-success" t-on-click="() => this.argSaveClose()"><img class="arg_icon me-1" src="/arg_pyme_ui/static/icons/lucide/panel-top-close.svg" alt=""/>Guardar y cerrar</button><button type="button" class="btn btn-outline-danger o_form_button_cancel" t-on-click="() => this.discard()" data-hotkey="j"><img class="arg_icon me-1" src="/arg_pyme_ui/static/icons/lucide/x.svg" alt=""/>Descartar</button></t><button type="button" class="btn btn-outline-secondary" t-on-click="() => this.argBack()"><img class="arg_icon me-1" src="/arg_pyme_ui/static/icons/lucide/arrow-left.svg" alt=""/>Volver</button><button t-if="this.canCreate" type="button" class="btn btn-outline-primary" t-on-click="() => this.create()" data-hotkey="c"><img class="arg_icon me-1" src="/arg_pyme_ui/static/icons/lucide/plus.svg" alt=""/>Nuevo</button></div></t></templates>
