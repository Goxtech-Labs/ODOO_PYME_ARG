<templates xml:space="preserve"><t t-name="arg_pyme_ui.DocumentButtons"><div class="arg_document_actions d-flex flex-wrap gap-1" role="toolbar" aria-label="Acciones del documento"><t t-if="this.canEdit"><button type="button" class="btn btn-success o_form_button_save" t-on-click="() => this.saveButtonClicked()" data-hotkey="s"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="me-1"><path d="M4 3h13l3 3v15H4z M7 3v6h9V3 M7 21v-8h10v8"/></svg>Guardar</button><button t-if="this.canCreate" type="button" class="btn btn-outline-success" t-on-click="() => this.argSaveNew()"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="me-1"><path d="M3 3h12l3 3v7 M3 3v18h9 M6 3v6h8V3 M18 15v6 M15 18h6"/></svg>Guardar y nuevo</button><button type="button" class="btn btn-outline-success" t-on-click="() => this.argSaveClose()"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="me-1"><path d="M3 3h12l3 3v6 M3 3v18h8 M6 3v6h8V3 M15 15l6 6 M21 15l-6 6"/></svg>Guardar y cerrar</button><button type="button" class="btn btn-outline-danger o_form_button_cancel" t-on-click="() => this.discard()" data-hotkey="j"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="me-1"><path d="M6 6l12 12 M18 6L6 18"/></svg>Descartar</button></t><button type="button" class="btn btn-outline-secondary" t-on-click="() => this.argBack()"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="me-1"><path d="M20 12H4 M10 6l-6 6 6 6"/></svg>Volver</button><button t-if="this.canCreate" type="button" class="btn btn-outline-primary" t-on-click="() => this.create()" data-hotkey="c"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="me-1"><path d="M5 3h10l4 4v14H5z M15 3v5h4 M8 14h8 M12 10v8"/></svg>Nuevo</button></div></t></templates>
