<templates xml:space="preserve">
<t t-name="arg_pyme_ui.Home"><div class="arg_home p-3 p-md-4 overflow-auto h-100"><header class="arg_home_banner p-4"><span class="arg_wordmark">ARG</span><h1>Tu gestión, en orden</h1><p>Los mismos pasos. Los datos necesarios. Tu información bajo tu control.</p></header><nav class="arg_areas_grid my-4" aria-label="Circuitos de gestión"><button t-foreach="this.areas" t-as="area" t-key="area.id" class="arg_area_card" t-att-disabled="!area.target" t-on-click="() => this.openArea(area)"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path t-att-d="this.areaIcon(area.name)"/></svg><strong t-out="area.name"/><span t-out="area.target ? 'Abrir documentos' : 'Sin acciones disponibles'"/></button></nav><section class="arg_home_help"><h2>Aprender y resolver</h2><a class="btn btn-primary me-2" href="/arg/ayuda" target="_blank" rel="noopener">Manuales y tutoriales</a><a class="btn btn-outline-primary" href="/arg/soporte" target="_blank" rel="noopener">Soporte ARG</a></section><details class="my-4"><summary>Odoo avanzado</summary><div class="d-flex flex-wrap gap-2 my-3"><button t-foreach="this.otherApps" t-as="app" t-key="app.id" class="btn btn-outline-secondary" t-on-click="() => this.openApp(app)" t-out="app.name"/></div></details><footer class="arg_attribution">Proyecto comunitario impulsado por Gonzalo Sarubilo · GoxtechLabs · <a href="/arg/acerca" target="_blank" rel="noopener">Acerca de ARG</a></footer></div></t>
<t t-name="arg_pyme_ui.CircuitNav"><nav class="arg_circuit_nav d-none d-xl-flex align-items-center gap-1" aria-label="Acceso a circuitos"><t t-foreach="this.areas" t-as="area" t-key="area.id"><button t-if="area.target" class="btn btn-sm" t-on-click="() => this.openArea(area)" t-out="area.name"/></t><a class="btn btn-sm" href="/arg/soporte" target="_blank" rel="noopener" aria-label="Soporte ARG">Ayuda</a></nav></t>
</templates>
