<templates xml:space="preserve">
<t t-name="arg_pyme_ui.Home">
 <div class="arg_home p-3 p-md-4 overflow-auto h-100">
  <header class="arg_home_banner">
   <div class="arg_home_intro"><span class="arg_eyebrow">SOFTWARE LIBRE · COMUNIDAD · ARGENTINA</span><div class="arg_brand"><span class="arg_flag" aria-label="Bandera argentina"><span>☀</span></span><span>PYMES <b>ARG</b></span></div><h1>Tu gestión,<br/>en orden.</h1><p>Del presupuesto al cobro.<br/>Los mismos pasos, los datos necesarios.</p><span class="arg_sovereignty">Tus datos. Tu servidor. Tu decisión.</span></div>
   <img class="arg_home_industry" src="/arg_pyme_ui/static/img/industria-arg-hero-v1.png" alt="Ilustración de industria, logística y gestión de pymes argentinas"/>
  </header>
  <section class="arg_circuits"><div class="arg_section_heading"><h2>¿En qué vamos a trabajar?</h2><span>Cinco circuitos. Un mismo orden.</span></div>
   <nav class="arg_areas_grid" aria-label="Circuitos de gestión"><button t-foreach="this.areas" t-as="area" t-key="area.id" class="arg_area_card" t-att-disabled="!area.target" t-on-click="() => this.openArea(area)"><span class="arg_area_icon"><img class="arg_icon" t-att-src="this.iconUrl(this.areaIcon(area.name))" alt=""/></span><strong t-out="area.name"/><span t-out="area.target ? 'Abrir documentos' : 'Sin acciones disponibles'"/><img class="arg_card_arrow arg_icon" t-att-src="this.iconUrl('arrow-up-right')" alt=""/></button></nav>
  </section>
  <section class="arg_home_help"><div><h2>Aprender, compartir y resolver</h2><p>Documentación abierta y ayuda para tu día a día.</p></div><div class="d-flex flex-wrap gap-2"><a class="btn btn-primary" href="/arg/ayuda" target="_blank" rel="noopener"><img class="arg_icon arg_icon_white" t-att-src="this.iconUrl('book-open')" alt=""/> Manuales y tutoriales</a><a class="btn btn-outline-primary" href="/arg/soporte" target="_blank" rel="noopener">Soporte ARG</a></div></section>
  <details class="arg_advanced my-4"><summary>Odoo avanzado</summary><div class="d-flex flex-wrap gap-2 my-3"><button t-foreach="this.otherApps" t-as="app" t-key="app.id" class="btn btn-outline-secondary" t-on-click="() => this.openApp(app)" t-out="app.name"/></div></details>
  <footer class="arg_attribution">Impulsado por Gonzalo Sarubilo · GoxtechLabs · <a href="/arg/acerca" target="_blank" rel="noopener">Un proyecto para compartir conocimiento</a></footer>
 </div>
</t>
<t t-name="arg_pyme_ui.WorkspaceRibbon">
 <section t-if="this.visible" class="arg_workspace" aria-label="Cinta de gestión ARG">
  <nav class="arg_ribbon_tabs" aria-label="Circuitos"><button class="arg_ribbon_home" t-on-click="() => this.openHome()"><img class="arg_icon" t-att-src="this.iconUrl('house')" alt=""/> Inicio</button><button t-foreach="this.availableAreas" t-as="area" t-key="area.id" class="arg_ribbon_tab" t-att-class="{'is-active':this.activeArea?.id === area.id}" t-att-aria-pressed="this.activeArea?.id === area.id ? 'true' : 'false'" t-on-click="() => this.selectArea(area)" t-out="area.name"/><button class="arg_ribbon_collapse" t-on-click="() => this.state.collapsed = !this.state.collapsed" t-att-aria-expanded="this.state.collapsed ? 'false' : 'true'" aria-controls="arg-ribbon-commands" t-att-title="this.state.collapsed ? 'Mostrar cinta' : 'Contraer cinta'" t-att-aria-label="this.state.collapsed ? 'Mostrar cinta' : 'Contraer cinta'"><img class="arg_icon" t-att-src="this.iconUrl('chevron-down')" alt=""/></button></nav>
  <div t-if="!this.state.collapsed" id="arg-ribbon-commands" class="arg_ribbon_commands">
   <section t-foreach="this.groups" t-as="group" t-key="group.name" class="arg_ribbon_group" t-att-aria-label="group.name"><div class="arg_ribbon_items"><button t-foreach="group.items" t-as="item" t-key="item.id" class="arg_ribbon_command" t-on-click="() => this.openCommand(item)"><img class="arg_icon" t-att-src="this.iconUrl(this.commandIcon(item.name))" alt=""/><span t-out="item.name"/></button></div><span class="arg_ribbon_group_label" t-out="group.name"/></section>
   <section class="arg_ribbon_group arg_ribbon_help" aria-label="Ayuda"><div class="arg_ribbon_items"><a href="/arg/ayuda" target="_blank" rel="noopener" class="arg_ribbon_command"><img class="arg_icon" t-att-src="this.iconUrl('book-open')" alt=""/><span>Aprender</span></a><a href="/arg/soporte" target="_blank" rel="noopener" class="arg_ribbon_command"><img class="arg_icon" t-att-src="this.iconUrl('circle-help')" alt=""/><span>Soporte ARG</span></a></div><span class="arg_ribbon_group_label">Comunidad</span></section>
  </div>
 </section>
</t>
<t t-inherit="web.WebClient" t-inherit-mode="extension"><xpath expr="//NavBar" position="after"><ArgWorkspaceRibbon t-if="!this.state.fullscreen"/></xpath></t>
</templates>
