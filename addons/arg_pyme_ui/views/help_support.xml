<record id="type_arg_form" model="ir.ui.view"><field name="name">arg.type.common.form</field><field name="model">arg.pyme.document.type</field><field name="inherit_id" ref="arg_pyme_base.document_type_form"/><field name="arch" type="xml"><xpath expr="//form" position="attributes"><attribute name="js_class">arg_form</attribute></xpath></field></record>
<record id="action_arg_home" model="ir.actions.client"><field name="name">Gestión ARG</field><field name="tag">arg_pyme.home</field></record>
