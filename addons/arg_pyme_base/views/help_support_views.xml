<odoo>
<record id="help_resource_list" model="ir.ui.view"><field name="name">arg.help.resource.list</field><field name="model">arg.pyme.help.resource</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="name"/><field name="module_key"/><field name="version_min"/><field name="is_compatible" readonly="1"/><field name="version_max" optional="hide"/><field name="state" widget="badge"/><field name="review_date"/></list></field></record>
<record id="help_resource_form" model="ir.ui.view"><field name="name">arg.help.resource.form</field><field name="model">arg.pyme.help.resource</field><field name="arch" type="xml"><form><header><button name="action_open_video" type="object" string="Ver tutorial" invisible="state != 'current' or not url or not is_compatible"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="module_key"/><field name="task"/><field name="url" widget="url"/><field name="manual_url" widget="url"/></group><group string="Compatibilidad y mantenimiento"><field name="version_min"/><field name="is_compatible" readonly="1"/><field name="version_max"/><field name="review_date"/><field name="reviewer_id"/><field name="replacement_id"/><field name="active"/></group><field name="manual_text"/></sheet></form></field></record>
<record id="action_help_resources" model="ir.actions.act_window"><field name="name">Manuales y tutoriales ARG</field><field name="res_model">arg.pyme.help.resource</field><field name="view_mode">list,form</field></record>
<record id="arg_settings_view" model="ir.ui.view"><field name="name">res.config.settings.arg</field><field name="model">res.config.settings</field><field name="inherit_id" ref="base.res_config_settings_view_form"/><field name="arch" type="xml"><xpath expr="//form" position="inside"><app string="Gestión ARG" name="arg_pyme_base" groups="base.group_system"><block title="Soporte general administrado"><setting string="Canal principal"><field name="arg_support_channel"/></setting><setting string="Correo"><field name="arg_support_email" placeholder="Sin configurar"/></setting><setting string="WhatsApp"><field name="arg_support_whatsapp" placeholder="Número internacional"/></setting><setting string="Sistema de tickets"><field name="arg_support_tickets" placeholder="https://"/></setting></block><block title="Conocimiento compartido"><setting string="Ayuda por módulo"><a type="action" name="%(action_help_resources)d" class="btn btn-link">Administrar manuales y tutoriales</a><div class="text-muted">Los enlaces se actualizan sin reinstalar módulos. Abrir soporte no envía información automáticamente.</div></setting></block></app></xpath></field></record>
</odoo>
