<templates xml:space="preserve">
<t t-name="arg_pyme_catalogo.VariantMatrix">
<div class="arg_variant_matrix arg_price_matrix h-100 overflow-auto p-3">
 <div class="d-flex flex-wrap align-items-center gap-2 mb-3"><h2 class="me-auto mb-0"><img class="arg_icon me-2" src="/arg_pyme_ui/static/icons/lucide/package.svg" alt=""/>Variantes ARG</h2><button class="btn btn-secondary" t-att-disabled="!this.state.template || this.state.loading" t-on-click="this.prices">Precios</button><button class="btn btn-primary" t-att-disabled="!this.selection.length || this.state.loading" t-on-click="this.labels"><img class="arg_icon me-1" src="/arg_pyme_ui/static/icons/lucide/printer.svg" alt=""/>Preparar etiquetas (<t t-esc="this.selection.length"/>)</button></div>
 <form class="d-flex flex-wrap align-items-end gap-2 mb-2" t-on-submit.prevent="() => this.searchTemplates(0)"><label>Buscar producto<input class="form-control" t-att-value="this.state.templateQuery" t-on-input="ev => this.state.templateQuery=ev.target.value" placeholder="Código o nombre"/></label><button type="submit" class="btn btn-secondary">Buscar</button><label>Producto<select class="form-select" t-att-disabled="this.state.loading" t-att-value="this.state.template?.id || ''" t-on-change="ev => ev.target.value &amp;&amp; this.selectTemplate(Number(ev.target.value))"><option value="">Elegir producto o servicio</option><option t-if="this.state.template &amp;&amp; !this.state.templates.some(p => p.id===this.state.template.id)" t-att-value="this.state.template.id" t-esc="this.state.template.name"/><option t-foreach="this.state.templates" t-as="p" t-key="p.id" t-att-value="p.id" t-esc="p.name"/></select></label><button type="button" class="btn btn-secondary" t-att-disabled="!this.state.templateOffset" t-on-click="() => this.searchTemplates(Math.max(0,this.state.templateOffset-30))">Productos anteriores</button><button type="button" class="btn btn-secondary" t-att-disabled="this.state.templateOffset+30 &gt;= this.state.templateCount" t-on-click="() => this.searchTemplates(this.state.templateOffset+30)">Más productos</button></form>
 <t t-if="this.state.template">
  <p class="text-muted"><t t-esc="this.state.company"/> · <strong t-esc="this.state.template.name"/>. Consulta de variantes existentes; no genera combinaciones ni modifica cantidades.</p>
  <form class="d-flex flex-wrap align-items-end gap-2 mb-2" t-on-submit.prevent="() => this.load(0,0)">
   <label>Columnas<select class="form-select" t-att-value="this.state.x || ''" t-att-disabled="this.state.loading" t-on-change="ev => this.axis('x',ev)"><option value="">Sin eje</option><option t-foreach="this.state.lines" t-as="line" t-key="line.id" t-att-value="line.id" t-esc="line.name"/></select></label>
   <label>Filas<select class="form-select" t-att-value="this.state.y || ''" t-att-disabled="this.state.loading" t-on-change="ev => this.axis('y',ev)"><option value="">Sin eje</option><option t-foreach="this.state.lines" t-as="line" t-key="line.id" t-att-value="line.id" t-esc="line.name"/></select></label>
   <label t-if="this.state.x">Buscar valor de columna<input class="form-control" t-att-value="this.state.xQuery" t-on-input="ev => this.state.xQuery=ev.target.value"/></label><label t-if="this.state.y">Buscar valor de fila<input class="form-control" t-att-value="this.state.yQuery" t-on-input="ev => this.state.yQuery=ev.target.value"/></label><button type="submit" class="btn btn-secondary" t-att-disabled="this.state.loading">Aplicar filtros</button>
  </form>
  <div class="d-flex flex-wrap gap-2 mb-2"><div t-foreach="this.fixedLines" t-as="line" t-key="line.id"><span class="me-1" t-esc="line.name"/><button class="btn btn-secondary" t-att-disabled="this.state.loading" t-on-click="() => this.pick(line)"><t t-esc="this.state.fixed[String(line.id)]?.name || 'Elegir valor'"/></button></div></div>
  <p class="text-muted">Cada celda conserva su unidad. Existencia y libre corresponden al alcance nativo visible de la compañía actual; no son una consulta histórica ni por depósito. — indica dato no determinado o no disponible.</p>
 </t>
 <div class="alert alert-danger" role="alert" t-if="this.state.error" t-esc="this.state.error"/><p role="status" t-if="this.state.loading">Cargando variantes…</p>
 <div class="table-responsive" t-if="this.state.template"><table class="table table-sm table-bordered align-middle"><thead><tr><th scope="col">Atributo / variante</th><th scope="col" t-foreach="this.state.columns" t-as="column" t-key="column.id" t-esc="column.name"/></tr></thead><tbody><tr t-foreach="this.state.rows" t-as="row" t-key="row.id"><th scope="row" t-esc="row.name"/><td t-foreach="row.cells" t-as="cell" t-key="cell.key">
  <span t-if="cell.status==='excluded'" class="text-muted">Excluida por configuración</span><span t-elif="cell.status==='unknown'" class="text-muted">Sin variante activa visible o aún no generada</span>
  <t t-else=""><label class="d-flex gap-2 align-items-start"><input type="checkbox" t-att-checked="!!this.state.selected[String(cell.id)]" t-att-disabled="this.state.loading" t-on-change="ev => this.toggle(cell,ev)"/><span><strong t-esc="cell.code || 'Sin código'"/><span class="d-block" t-esc="cell.name"/></span></label><button class="btn btn-sm btn-secondary my-1" t-att-disabled="this.state.loading" t-on-click="() => this.open(cell)">Abrir ficha</button><small class="d-block" t-if="cell.barcode">Barras: <t t-esc="cell.barcode"/></small><small class="d-block">Unidad: <t t-esc="cell.unit"/></small>
   <div class="text-end" t-if="cell.quantities.status==='known'">Existencia: <t t-esc="this.number(cell.quantities.physical)"/><br/>Libre: <t t-esc="this.number(cell.quantities.free)"/></div><small class="d-block text-muted" t-elif="cell.quantities.status==='not_applicable'">Cantidades: no aplica</small><small class="d-block text-muted" t-elif="cell.quantities.status==='unavailable'">Cantidades: Stock ARG no disponible</small><small class="d-block text-muted" t-else="">Cantidades: no determinado</small>
  </t>
 </td></tr><tr t-if="!this.state.rows.length &amp;&amp; !this.state.loading"><td t-att-colspan="this.state.columns.length+1">Elegí un producto o revisá los filtros de valores.</td></tr></tbody></table></div>
 <div t-if="this.state.template" class="d-flex flex-wrap align-items-center gap-2"><button class="btn btn-secondary" t-att-disabled="!this.state.xOffset || this.state.loading" t-on-click="() => this.load(Math.max(0,this.state.xOffset-8),this.state.yOffset)">Columnas anteriores</button><span>Columnas <t t-esc="this.state.xCount ? this.state.xOffset+1 : 0"/>–<t t-esc="Math.min(this.state.xOffset+8,this.state.xCount)"/> / <t t-esc="this.state.xCount"/></span><button class="btn btn-secondary" t-att-disabled="this.state.xOffset+8 &gt;= this.state.xCount || this.state.loading" t-on-click="() => this.load(this.state.xOffset+8,this.state.yOffset)">Más columnas</button><button class="btn btn-secondary" t-att-disabled="!this.state.yOffset || this.state.loading" t-on-click="() => this.load(this.state.xOffset,Math.max(0,this.state.yOffset-15))">Filas anteriores</button><span>Filas <t t-esc="this.state.yCount ? this.state.yOffset+1 : 0"/>–<t t-esc="Math.min(this.state.yOffset+15,this.state.yCount)"/> / <t t-esc="this.state.yCount"/></span><button class="btn btn-secondary" t-att-disabled="this.state.yOffset+15 &gt;= this.state.yCount || this.state.loading" t-on-click="() => this.load(this.state.xOffset,this.state.yOffset+15)">Más filas</button></div>
 <details t-if="this.selection.length" class="mt-3"><summary>Selección de etiquetas conservada entre páginas (<t t-esc="this.selection.length"/>)</summary><ul><li t-foreach="this.selection" t-as="p" t-key="p.id"><t t-esc="p.code"/> · <t t-esc="p.name"/> <button class="btn btn-sm btn-secondary" t-on-click="() => this.remove(p.id)">Quitar</button></li></ul></details>
</div></t>
<t t-name="arg_pyme_catalogo.VariantValuePicker"><Dialog title="this.props.line.name" size="'md'"><form class="d-flex gap-2 mb-2" t-on-submit.prevent="() => this.load(0)"><label>Buscar valor<input class="form-control" t-att-value="this.state.query" t-on-input="ev => this.state.query=ev.target.value"/></label><button type="submit" class="btn btn-secondary">Buscar</button></form><p role="status" t-if="this.state.loading">Cargando…</p><p role="alert" t-if="this.state.error" t-esc="this.state.error"/><div class="d-flex flex-wrap gap-2"><button class="btn btn-secondary" t-foreach="this.state.rows" t-as="value" t-key="value.id" t-att-disabled="this.state.loading" t-on-click="() => this.select(value)" t-esc="value.name"/></div><p t-if="!this.state.rows.length &amp;&amp; !this.state.loading">Sin valores visibles para esta búsqueda.</p><t t-set-slot="footer"><button class="btn btn-secondary" t-att-disabled="!this.state.offset || this.state.loading" t-on-click="() => this.load(Math.max(0,this.state.offset-30))">Anterior</button><span><t t-esc="this.state.count"/> valores</span><button class="btn btn-secondary" t-att-disabled="this.state.offset+30 &gt;= this.state.count || this.state.loading" t-on-click="() => this.load(this.state.offset+30)">Siguiente</button><button class="btn btn-secondary" t-on-click="this.props.close">Cerrar</button></t></Dialog></t>
</templates>
