<odoo>
<record id="product_list" model="ir.ui.view"><field name="name">product.template.arg.list</field><field name="model">product.template</field><field name="arch" type="xml"><list js_class="arg_list"><field name="default_code" string="Código"/><field name="name"/><field name="type"/><field name="uom_id"/><field name="list_price" string="Precio base"/><field name="currency_id"/><field name="categ_id" optional="hide"/><field name="active" optional="hide"/></list></field></record>
<record id="product_form" model="ir.ui.view"><field name="name">product.template.arg.form</field><field name="model">product.template</field><field name="arch" type="xml"><form js_class="arg_form"><header><button name="action_arg_advanced" type="object" string="Avanzado"/></header><sheet><group><group><field name="name"/><field name="type"/><field name="default_code"/><field name="uom_id"/></group><group><field name="list_price" string="Precio base"/><field name="currency_id" readonly="1"/><field name="standard_price" string="Costo" groups="arg_pyme_base.group_manager"/><field name="cost_currency_id" readonly="1" groups="arg_pyme_base.group_manager"/></group></group><notebook><page string="Clasificación y opciones"><group><field name="categ_id"/><field name="sale_ok"/><field name="purchase_ok"/></group><field name="attribute_line_ids" groups="arg_pyme_base.group_manager"><list editable="bottom"><field name="attribute_id"/><field name="value_ids" widget="many2many_tags"/></list></field><p class="text-muted">Los atributos son opcionales. Las variantes y sus reglas se administran con las herramientas nativas.</p></page><page string="Descripción"><field name="description"/></page></notebook></sheet></form></field></record>
<record id="product_search" model="ir.ui.view"><field name="name">product.template.arg.search</field><field name="model">product.template</field><field name="arch" type="xml"><search><field name="name"/><field name="default_code"/><field name="categ_id"/><filter name="goods" string="Productos" domain="[('type','=','consu')]"/><filter name="services" string="Servicios" domain="[('type','=','service')]"/><separator/><filter name="sale" string="Venta" domain="[('sale_ok','=',True)]"/><filter name="purchase" string="Compra" domain="[('purchase_ok','=',True)]"/></search></field></record>
<record id="action_products" model="ir.actions.act_window"><field name="name">Productos y servicios ARG</field><field name="res_model">product.template</field><field name="view_mode">list,form</field><field name="view_id" ref="product_list"/><field name="search_view_id" ref="product_search"/></record><record id="action_products_list" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="product_list"/><field name="act_window_id" ref="action_products"/></record>
<record id="action_products_form" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="product_form"/><field name="act_window_id" ref="action_products"/></record>
<menuitem id="menu_products" name="Productos y servicios" parent="arg_pyme_base.menu_arg_stock" action="action_products" sequence="10"/>
<menuitem id="menu_sale_products" name="Productos y servicios" parent="arg_pyme_base.menu_arg_ventas" action="action_products" sequence="85"/>
<menuitem id="menu_purchase_products" name="Productos y servicios" parent="arg_pyme_base.menu_arg_compras" action="action_products" sequence="85"/>
</odoo>
