<odoo>
    <record id="invoice_purchase_arg" model="ir.ui.view">
        <field name="name">account.move.purchase.arg</field><field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Move the existing supplier date nodes, preserving native modifiers/widgets. -->
            <xpath expr="//group[@id='header_left_group']/label[@for='partner_id'][1]" position="before">
                <xpath expr="//group[@id='header_right_group']/field[@name='invoice_date' and @required]/preceding-sibling::*[1][self::label[@for='invoice_date']]" position="move"/>
                <xpath expr="//group[@id='header_right_group']/field[@name='invoice_date' and @required]" position="move"/>
            </xpath>
            <xpath expr="//group[@id='header_left_group']/label[@for='ref']" position="attributes">
                <attribute name="string">N.º del comprobante del proveedor</attribute>
            </xpath>
            <xpath expr="//group[@id='header_left_group']/field[@name='ref' and @nolabel='1']" position="attributes">
                <attribute name="string">N.º del comprobante del proveedor</attribute>
                <attribute name="placeholder">Número que figura en el comprobante</attribute>
            </xpath>
            <xpath expr="//group[@id='header_right_group']/field[@name='date']" position="before">
                <separator string="Condiciones y contabilidad" colspan="2" invisible="move_type not in ['in_invoice','in_refund','in_receipt']"/>
            </xpath>
            <xpath expr="//sheet" position="inside"><widget name="arg_document_header" invisible="move_type not in ['in_invoice','in_refund']"/></xpath>
            <xpath expr="//header" position="inside">
                <button name="action_arg_print" type="object" string="Documento ARG" invisible="move_type not in ['in_invoice','in_refund']"/>
                <button name="action_arg_purchase_treasury" type="object" string="Administración ARG" invisible="move_type not in ['in_invoice','in_refund']"/>
            </xpath>
        </field>
    </record>
    <record id="action_purchase_bills" model="ir.actions.act_window">
        <field name="name">Facturas y notas recibidas ARG</field><field name="res_model">account.move</field>
        <field name="view_mode">list,form</field><field name="domain">[('move_type','in',['in_invoice','in_refund'])]</field>
        <field name="context">{'default_move_type':'in_invoice'}</field>
    </record>
    <menuitem id="menu_purchase_bills" name="Facturas y notas recibidas" parent="arg_pyme_base.menu_arg_compras" action="action_purchase_bills" sequence="40"/>
</odoo>
