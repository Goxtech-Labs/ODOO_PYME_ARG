<odoo>
<record id="partner_list" model="ir.ui.view"><field name="name">res.partner.arg.list</field><field name="model">res.partner</field><field name="arch" type="xml"><list js_class="arg_list" delete="0"><field name="ref" optional="show"/><field name="name"/><field name="arg_role_ids" widget="many2many_tags"/><field name="vat" optional="show"/><field name="phone" optional="show"/><field name="email" optional="hide"/><field name="city" optional="hide"/><field name="company_id" groups="base.group_multi_company" optional="hide"/></list></field></record>
<record id="partner_form" model="ir.ui.view"><field name="name">res.partner.arg.form</field><field name="model">res.partner</field><field name="arch" type="xml"><form js_class="arg_form" delete="0"><header><button name="action_arg_advanced" type="object" string="Ficha avanzada"/></header><sheet><div class="alert alert-info" role="status" invisible="not arg_duplicate_count"><field name="arg_duplicate_count" readonly="1"/> posibles coincidencias. <button name="action_arg_duplicates" type="object" string="Revisar" class="btn btn-link"/></div><group string="1 · Identificación"><field name="name" placeholder="Nombre o razón social" required="1"/><field name="arg_role_ids" widget="many2many_tags" options="{'no_create': True}"/><field name="ref" placeholder="Código opcional; conserva ceros iniciales"/></group><group string="2 · Contacto"><field name="phone"/><field name="email"/></group><notebook><page string="Dirección y datos fiscales"><group><field name="is_company"/><field name="vat"/><field name="country_id"/><field name="state_id" domain="[('country_id','=',country_id)]"/><field name="city"/><field name="street"/><field name="street2"/><field name="zip"/></group></page><page string="Condiciones"><group><field name="arg_currency_id"/><field name="arg_conditions_note"/><field name="company_id" groups="base.group_multi_company"/></group><div class="text-muted">La ficha avanzada conserva las condiciones nativas disponibles en esta instalación. Los documentos nuevos toman valores conocidos; los anteriores mantienen su historia.</div></page><page string="Información adicional"><field name="comment"/><field name="active"/></page></notebook></sheet></form></field></record>
<record id="partner_search" model="ir.ui.view"><field name="name">res.partner.arg.search</field><field name="model">res.partner</field><field name="arch" type="xml"><search><field name="name"/><field name="ref"/><field name="vat"/><field name="phone"/><field name="arg_role_ids"/><filter name="customers" string="Clientes" domain="[('arg_role_ids.code','=','customer')]"/><filter name="suppliers" string="Proveedores" domain="[('arg_role_ids.code','=','supplier')]"/><filter name="archived" string="Archivados" domain="[('active','=',False)]"/></search></field></record>
<record id="action_all_partners" model="ir.actions.act_window"><field name="name">Terceros ARG</field><field name="res_model">res.partner</field><field name="view_mode">list,form</field><field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'list','view_id':ref('partner_list')}),(0,0,{'view_mode':'form','view_id':ref('partner_form')})]"/><field name="search_view_id" ref="partner_search"/></record>
<record id="action_customers" model="ir.actions.act_window"><field name="name">Clientes ARG</field><field name="res_model">res.partner</field><field name="view_mode">list,form</field><field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'list','view_id':ref('partner_list')}),(0,0,{'view_mode':'form','view_id':ref('partner_form')})]"/><field name="search_view_id" ref="partner_search"/><field name="domain">[('arg_role_ids.code','=','customer')]</field><field name="context" eval="{'default_arg_role_ids':[(6,0,[ref('role_customer')])]}"/></record>
<record id="action_suppliers" model="ir.actions.act_window"><field name="name">Proveedores ARG</field><field name="res_model">res.partner</field><field name="view_mode">list,form</field><field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'list','view_id':ref('partner_list')}),(0,0,{'view_mode':'form','view_id':ref('partner_form')})]"/><field name="search_view_id" ref="partner_search"/><field name="domain">[('arg_role_ids.code','=','supplier')]</field><field name="context" eval="{'default_arg_role_ids':[(6,0,[ref('role_supplier')])]}"/></record>
<menuitem id="menu_customers" name="Clientes" parent="arg_pyme_base.menu_arg_ventas" action="action_customers" sequence="90"/>
<menuitem id="menu_suppliers" name="Proveedores" parent="arg_pyme_base.menu_arg_compras" action="action_suppliers" sequence="90"/>
<menuitem id="menu_all_partners" name="Terceros" parent="arg_pyme_base.menu_arg_config" action="action_all_partners" sequence="20"/>
</odoo>
