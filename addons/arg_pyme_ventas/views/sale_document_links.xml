<odoo>
<record id="invoice_arg_links" model="ir.ui.view"><field name="name">account.move.arg.links</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><widget name="arg_document_header" invisible="move_type not in ['out_invoice','out_refund']"/></xpath><xpath expr="//header" position="inside"><button name="action_arg_print" type="object" string="Documento ARG" invisible="move_type not in ['out_invoice','out_refund']"/><button name="action_arg_treasury" type="object" string="Administración ARG" invisible="move_type not in ['out_invoice','out_refund']"/></xpath></field></record>
<record id="action_invoices" model="ir.actions.act_window"><field name="name">Facturas y notas de venta ARG</field><field name="res_model">account.move</field><field name="view_mode">list,form</field><field name="domain">[('move_type','in',['out_invoice','out_refund'])]</field><field name="context">{'default_move_type':'out_invoice'}</field></record>
<menuitem id="menu_invoices" name="Facturas y notas" parent="arg_pyme_base.menu_arg_ventas" action="action_invoices" sequence="40"/>
</odoo>
