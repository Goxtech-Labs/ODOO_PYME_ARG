<odoo>
<record id="quotation_list" model="ir.ui.view"><field name="name">arg.pyme.quotation.list</field><field name="model">arg.pyme.quotation</field><field name="arch" type="xml"><list js_class="arg_list"><field name="arg_number" string="Presupuesto"/><field name="date"/><field name="partner_id"/><field name="revision_number"/><field name="state" widget="badge"/><field name="amount_total"/><field name="currency_id"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
<record id="quotation_form" model="ir.ui.view"><field name="name">arg.pyme.quotation.form</field><field name="model">arg.pyme.quotation</field><field name="arch" type="xml"><form js_class="arg_form"><header>
<button name="action_issue" type="object" string="Emitir presupuesto" class="btn-primary" invisible="state != 'draft'"/>
<button name="action_accept_quantities" type="object" string="Confirmar cantidades" class="btn-primary" invisible="state not in ['issued','partially_confirmed']" groups="arg_pyme_base.group_manager"/>
<button name="action_generate_order" type="object" string="Generar pedido" class="btn-primary" invisible="state not in ['partially_confirmed','confirmed']"/>
<button name="action_new_revision" type="object" string="Nueva revisión" invisible="state == 'draft'"/>
<button name="action_update_prices" type="object" string="Actualizar desde lista" invisible="accepted_snapshot or state not in ['draft','issued']" confirm="Se reemplazarán los precios e impuestos del detalle por los conocidos de la lista actual."/><button name="action_arg_print" type="object" string="Imprimir"/>
<button name="action_reject" type="object" string="Rechazar" invisible="accepted_snapshot or state not in ['draft','issued']"/>
<button name="action_cancel" type="object" string="Cancelar" invisible="accepted_snapshot or state not in ['draft','issued']" groups="arg_pyme_base.group_manager"/>
<field name="state" widget="statusbar" statusbar_visible="draft,issued,partially_confirmed,confirmed"/>
</header><sheet><widget name="arg_document_header"/>
<field name="accepted_snapshot" invisible="1"/><field name="defaults_snapshot" invisible="1"/>
<group><group><field name="partner_id" readonly="accepted_snapshot or state not in ['draft','issued']"/><field name="date" readonly="accepted_snapshot or state not in ['draft','issued']"/><field name="valid_until" readonly="accepted_snapshot or state not in ['draft','issued']"/><field name="is_expired" invisible="not is_expired" readonly="1"/></group>
<group><field name="company_id" groups="base.group_multi_company" readonly="arg_number"/><field name="currency_id" readonly="accepted_snapshot or state not in ['draft','issued']"/><field name="pricelist_id" readonly="accepted_snapshot or state not in ['draft','issued']"/><field name="arg_reference" readonly="accepted_snapshot or state not in ['draft','issued']"/></group></group>
<field name="line_ids" readonly="accepted_snapshot or state not in ['draft','issued']"><list editable="bottom"><field name="sequence" widget="handle"/><field name="product_id"/><field name="description"/><field name="target_quantity_total"/><field name="uom_id"/><field name="carried_committed_quantity" optional="hide"/><field name="accepted_target_total" optional="show"/><field name="ordered_quantity_net" optional="show"/><field name="price_unit"/><field name="discount" optional="hide"/><field name="tax_ids" widget="many2many_tags" optional="show"/><field name="amount_total"/><field name="currency_id" column_invisible="True"/></list></field>
<group class="oe_subtotal_footer oe_right"><field name="amount_untaxed"/><field name="amount_tax"/><field name="amount_total"/></group>
<p class="text-muted">Las cantidades son objetivos acumulados. El precio de una revisión se aplica al saldo sin compromiso previo. Confirmar este documento no crea un pedido, entrega, factura ni cobro.</p>
<notebook><page string="Condiciones"><group><group><field name="invoice_partner_id" readonly="accepted_snapshot or state not in ['draft','issued']"/><field name="delivery_partner_id" readonly="accepted_snapshot or state not in ['draft','issued']"/><field name="payment_term_id" readonly="accepted_snapshot or state not in ['draft','issued']"/></group><group><field name="fiscal_position_id" readonly="accepted_snapshot or state not in ['draft','issued']"/><field name="document_tax_mode" readonly="accepted_snapshot or state not in ['draft','issued']"/><field name="allow_zero_price" readonly="accepted_snapshot or state not in ['draft','issued']"/></group></group><field name="notes" readonly="accepted_snapshot or state not in ['draft','issued']"/></page>
<page string="Pedidos"><field name="order_ids" readonly="1"><list create="0" delete="0"><field name="arg_number"/><field name="date_order"/><field name="state"/><field name="amount_total"/><field name="currency_id"/><field name="arg_commitment_released"/></list></field></page>
<page string="Historia"><group><field name="commercial_root_id"/><field name="previous_revision_id"/><field name="revision_number"/><field name="confirmed_at"/><field name="confirmed_by"/></group><field name="acceptance_ids" readonly="1"><list create="0" delete="0"><field name="create_date"/><field name="user_id"/><field name="operation_key"/></list></field></page></notebook>
</sheet></form></field></record>
<record id="quotation_search" model="ir.ui.view"><field name="name">arg.pyme.quotation.search</field><field name="model">arg.pyme.quotation</field><field name="arch" type="xml"><search><field name="arg_number"/><field name="partner_id"/><filter name="draft" string="Borrador" domain="[('state','=','draft')]"/><filter name="issued" string="Pendiente de confirmar" domain="[('state','=','issued')]"/><filter name="partial" string="Confirmado parcialmente" domain="[('state','=','partially_confirmed')]"/><filter name="confirmed" string="Confirmado" domain="[('state','=','confirmed')]"/></search></field></record>
<record id="action_quotations" model="ir.actions.act_window"><field name="name">Presupuestos ARG</field><field name="res_model">arg.pyme.quotation</field><field name="view_mode">list,form</field><field name="view_id" ref="quotation_list"/><field name="search_view_id" ref="quotation_search"/></record><record id="action_quotations_list" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="quotation_list"/><field name="act_window_id" ref="action_quotations"/></record>
<record id="action_quotations_form" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="quotation_form"/><field name="act_window_id" ref="action_quotations"/></record>
<menuitem id="menu_quotations" name="Presupuestos" parent="arg_pyme_base.menu_arg_ventas" action="action_quotations" sequence="10"/>
</odoo>
