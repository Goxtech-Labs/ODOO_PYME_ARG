<odoo>
<record id="order_list" model="ir.ui.view"><field name="name">sale.order.arg.list</field><field name="model">sale.order</field><field name="arch" type="xml"><list js_class="arg_list"><field name="arg_number" string="Pedido"/><field name="date_order"/><field name="partner_id"/><field name="arg_quotation_id"/><field name="state" widget="badge"/><field name="amount_total"/><field name="currency_id"/><field name="invoice_status" optional="hide"/><field name="arg_commitment_released" optional="hide"/></list></field></record>
<record id="order_form" model="ir.ui.view"><field name="name">sale.order.arg.form</field><field name="model">sale.order</field><field name="arch" type="xml"><form js_class="arg_form"><header><button name="action_confirm" type="object" string="Confirmar pedido" class="btn-primary" invisible="state not in ['draft','sent']" groups="arg_pyme_base.group_manager"/><button name="action_arg_invoice" type="object" string="Preparar factura" invisible="state != 'sale'"/><button name="action_view_invoice" type="object" string="Ver facturas"/><button name="action_arg_print" type="object" string="Imprimir"/><button name="action_cancel" type="object" string="Cancelar pedido" invisible="state == 'cancel'" groups="arg_pyme_base.group_manager"/><button name="action_arg_release" type="object" string="Liberar compromiso" invisible="state != 'cancel' or not arg_quotation_id or arg_commitment_released" groups="arg_pyme_base.group_manager"/><field name="state" widget="statusbar" statusbar_visible="draft,sale"/></header><sheet><widget name="arg_document_header"/><group><group><field name="date_order"/><field name="partner_id" readonly="arg_quotation_id or state not in ['draft','sent']"/><field name="arg_quotation_id"/><field name="arg_commitment_released" invisible="not arg_commitment_released"/></group><group><field name="company_id" groups="base.group_multi_company" readonly="arg_number"/><field name="currency_id" readonly="arg_quotation_id or state not in ['draft','sent']"/><field name="pricelist_id" readonly="arg_quotation_id or state not in ['draft','sent']"/><field name="client_order_ref"/></group></group>
<field name="order_line" readonly="arg_quotation_id or state not in ['draft','sent']"><list editable="bottom"><field name="product_id"/><field name="name"/><field name="product_uom_qty"/><field name="product_uom_id"/><field name="price_unit"/><field name="discount" optional="hide"/><field name="tax_ids" widget="many2many_tags"/><field name="price_total"/><field name="currency_id" column_invisible="True"/><field name="qty_invoiced_posted" optional="show"/></list></field>
<group class="oe_subtotal_footer oe_right"><field name="amount_untaxed"/><field name="amount_tax"/><field name="amount_total"/></group><p class="text-muted">La deuda cancelada puede incluir notas de crédito y ajustes. Los cobros registrados y sus aplicaciones pertenecen a Administración ARG. Los indicadores físicos se incorporan con el puente Stock ARG.</p>
<notebook><page string="Condiciones"><group><field name="partner_invoice_id" readonly="arg_quotation_id"/><field name="partner_shipping_id" readonly="arg_quotation_id"/><field name="payment_term_id" readonly="arg_quotation_id"/><field name="fiscal_position_id" readonly="arg_quotation_id"/><field name="document_tax_mode" readonly="arg_quotation_id"/></group><field name="note" readonly="arg_quotation_id"/></page><page string="Referencia nativa"><group><field name="name" readonly="1"/><field name="invoice_status"/><field name="user_id"/></group></page></notebook></sheet></form></field></record>
<record id="action_orders" model="ir.actions.act_window"><field name="name">Pedidos de cliente ARG</field><field name="res_model">sale.order</field><field name="view_mode">list,form</field><field name="view_id" ref="order_list"/></record><record id="action_orders_list" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="order_list"/><field name="act_window_id" ref="action_orders"/></record>
<record id="action_orders_form" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="order_form"/><field name="act_window_id" ref="action_orders"/></record>
<menuitem id="menu_orders" name="Pedidos de cliente" parent="arg_pyme_base.menu_arg_ventas" action="action_orders" sequence="20"/>
</odoo>
