<odoo>
<record id="action_report_document" model="ir.actions.report"><field name="name">Documento ARG</field><field name="model">arg.pyme.document.mixin</field><field name="report_type">qweb-pdf</field><field name="report_name">arg_pyme_documentos.document_report</field></record>
<template id="document_report"><t t-call="web.html_container"><t t-foreach="pages" t-as="p"><div class="article"><div class="page" style="font-family:sans-serif;color:#162d3e;font-size:12px"><t t-call="arg_pyme_documentos.document_header"/><h3 t-esc="p.get('partner_name','')"/><p t-esc="p.get('partner_address','')"/><p t-if="p.get('external_reference')">Referencia externa: <span t-esc="p['external_reference']"/></p><table style="width:100%;border-collapse:collapse"><thead><tr style="background:#e2f2fc"><th>Descripción</th><th>Cantidad</th><th>Unidad</th><th>Precio unitario</th><th>Importe</th></tr></thead><tbody><tr t-foreach="p.get('lines',[])" t-as="line"><td t-esc="line.get('description','')"/><td t-esc="line.get('quantity','')"/><td t-esc="line.get('unit','')"/><td t-esc="line.get('unit_price','')"/><td t-esc="line.get('total','')"/></tr></tbody></table><p>Moneda: <strong t-esc="p.get('currency','')"/></p><div t-foreach="p.get('totals',[])" t-as="total" style="text-align:right"><span t-esc="total['label']"/>: <strong t-esc="total['amount']"/></div><t t-call="arg_pyme_documentos.document_axes"/><p t-esc="p.get('notes','')"/><p style="font-size:10px;border-top:1px solid #69b8e7;padding-top:8px">Documento de gestión. No acredita autorización fiscal. Odoo Pymes ARG · Impulsado por Gonzalo Sarubilo / GoxtechLabs.</p></div></div></t></t></template>
</odoo>
