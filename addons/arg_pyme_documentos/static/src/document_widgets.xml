<templates xml:space="preserve">
<t t-name="arg_pyme_documentos.DocumentHeader"><div class="arg_document_header border-bottom mb-3 pb-2"><div class="d-flex align-items-center gap-3"><strong class="fs-4" t-esc="this.number"/><button class="btn btn-link" t-if="!this.props.record.isNew" t-on-click="this.openLinks">Origen y derivados</button></div><div class="d-flex flex-wrap gap-2"><details t-foreach="this.axes" t-as="axis" t-key="axis.label" class="border rounded p-2"><summary><strong t-esc="axis.label"/>: <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="me-1"><path t-att-d="this.stateIcon(axis.state)"/></svg><span t-esc="this.label(axis.state)"/><span t-if="axis.closed_shortfall"> · Cerrado con faltante</span></summary><p t-if="axis.explanation" t-esc="axis.explanation"/><ul><li t-foreach="axis.lines || []" t-as="line" t-key="line_index"><t t-esc="line.label"/>: <t t-esc="line.done"/> / <t t-esc="line.target"/> <t t-esc="line.unit"/><t t-if="line.unknown"> identificados; restante no determinado. <t t-esc="line.explanation"/></t><t t-else="">; pendiente <t t-esc="line.pending"/>; faltante cerrado <t t-esc="line.closed"/></t></li></ul></details></div></div></t>
<t t-name="arg_pyme_documentos.DocumentLinks"><div class="p-3 h-100 overflow-auto"><h2>Trazabilidad <t t-esc="this.state.number"/></h2><p class="text-muted">Documentos relacionados por referencias verificables. Se muestran únicamente los accesibles con tus permisos.</p><p t-if="!this.state.groups.length &amp;&amp; !this.state.line_links.length">Sin documentos relacionados disponibles.</p><section class="mb-3" t-foreach="this.state.groups" t-as="group" t-key="group_index"><h3 t-esc="group.label"/><div class="d-flex flex-wrap gap-2"><button class="btn btn-outline-primary" t-foreach="group.documents" t-as="doc" t-key="doc.id" t-on-click="() => this.open(group.model,doc.id)" t-esc="doc.name"/></div></section><div class="table-responsive" t-if="this.state.line_links.length"><h3>Trazabilidad por línea</h3><table class="table table-sm"><thead><tr><th>Origen</th><th>Línea origen</th><th>Destino</th><th>Línea destino</th><th>Cantidad</th></tr></thead><tbody><tr t-foreach="this.state.line_links" t-as="link" t-key="link_index"><td><button class="btn btn-link" t-on-click="() => this.open(link.source.model,link.source.id)" t-esc="link.source.name"/></td><td t-esc="link.source_line"/><td><button class="btn btn-link" t-on-click="() => this.open(link.target.model,link.target.id)" t-esc="link.target.name"/></td><td t-esc="link.target_line"/><td><t t-esc="link.quantity === null ? 'Sin desglosar' : link.quantity"/> <t t-esc="link.unit"/></td></tr></tbody></table></div></div></t>
</templates>
