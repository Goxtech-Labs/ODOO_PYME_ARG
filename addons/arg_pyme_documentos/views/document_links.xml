<odoo><template id="document_axes"><div t-foreach="p.get('axes',[])" t-as="axis"><strong t-esc="axis['label']"/>: <span t-esc="{'pending':'Pendiente','partial':'Parcial','complete':'Completo','na':'No corresponde','unknown':'No determinado'}.get(axis['state'],axis['state'])"/><span t-if="axis.get('closed_shortfall')"> · Cerrado con faltante</span><p t-if="axis.get('explanation')" t-esc="axis['explanation']"/><ul><li t-foreach="axis.get('lines',[])" t-as="line"><span t-esc="line.get('label','')"/>: <span t-esc="line.get('done',0)"/> / <span t-esc="line.get('target',0)"/> <span t-esc="line.get('unit','')"/><t t-if="line.get('unknown')"> identificados; restante no determinado. <span t-esc="line.get('explanation','')"/></t><t t-else="">; pendiente <span t-esc="line.get('pending',0)"/>; faltante cerrado <span t-esc="line.get('closed',0)"/></t></li></ul></div></template></odoo>
